# Copia questo file in /opt/mc-manager/.env sulla VPS e compila i valori.

# Accesso all'interfaccia (obbligatoria)
MANAGER_USER=admin
MANAGER_PASSWORD=

# Dove salvare mondi e config dei server
SERVERS_DIR=/srv/minecraft/servers

# Rete: 0.0.0.0 = raggiungibile da internet sulla porta MANAGER_PORT.
# Con HTTPS (sotto) usa 127.0.0.1.
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8080

# HTTPS con Caddy + Let's Encrypt: decommenta e punta il DNS del dominio sulla VPS.
# COMPOSE_PROFILES=https
# DOMAIN=mc.tuodominio.it

# Bilanciamento RAM
MEMORY_RESERVE=1g
HEAP_SHARE=0.8
RAM_BUDGET=
RESTART_WARNING=60

TZ=Europe/Rome
