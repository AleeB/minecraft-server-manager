# Copia questo file in deploy/.env (sul server: /opt/mc-manager/deploy/.env) e compila i valori.

# Accesso all'interfaccia (obbligatoria)
MANAGER_USER=admin
MANAGER_PASSWORD=

# Dove salvare mondi e config dei server
SERVERS_DIR=/srv/minecraft/servers

# Rete: 0.0.0.0 = raggiungibile da internet sulla porta MANAGER_PORT.
# Con HTTPS (sotto) usa 127.0.0.1.
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8080

# HTTPS con nginx + Let's Encrypt: punta il DNS del dominio sulla VPS, apri le porte 80 e 443,
# decommenta le righe sotto e imposta MANAGER_HOST=127.0.0.1.
# Impostando LETSENCRYPT_EMAIL accetti i termini di servizio di Let's Encrypt.
# COMPOSE_PROFILES=https
# DOMAIN=mc.tuodominio.it
# LETSENCRYPT_EMAIL=tu@example.com
# 1 = certificati di prova (staging), utile per i primi test senza consumare i limiti di Let's Encrypt
# LETSENCRYPT_STAGING=0

# Bilanciamento RAM
MEMORY_RESERVE=1g
HEAP_SHARE=0.8
RAM_BUDGET=
RESTART_WARNING=60

TZ=Europe/Rome
